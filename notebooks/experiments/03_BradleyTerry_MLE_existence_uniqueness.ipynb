    "# Centre both parameter vectors and compare them again.\n",
    "\n",
    "centered_original_parameters = center_parameters(\n",
    "    original_parameters\n",
    ")\n",
    "\n",
    "centered_shifted_parameters = center_parameters(\n",
    "    shifted_parameters\n",
    ")\n",
    "\n",
    "centering_comparison_table = pd.DataFrame({\n",
    "    \"item\": identifiability_items,\n",
    "    \"original\": original_parameters,\n",
    "    \"shifted\": shifted_parameters,\n",
    "    \"centered_original\": (\n",
    "        centered_original_parameters\n",
    "    ),\n",
    "    \"centered_shifted\": (\n",
