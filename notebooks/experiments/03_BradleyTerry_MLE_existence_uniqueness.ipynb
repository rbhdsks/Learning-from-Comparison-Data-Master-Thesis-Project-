   "source": [
    "# Compare all pairwise probabilities before and after shifting.\n",
    "\n",
    "number_of_identifiability_items = len(\n",
    "    identifiability_items\n",
    ")\n",
    "\n",
    "original_probability_matrix = np.full(\n",
    "    (\n",
    "        number_of_identifiability_items,\n",
    "        number_of_identifiability_items,\n",
    "    ),\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "shifted_probability_matrix = np.full_like(\n",
    "    original_probability_matrix,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "for item_i in range(\n",
    "    number_of_identifiability_items\n",
    "):\n",
    "    for item_j in range(\n",
    "        number_of_identifiability_items\n",
    "    ):\n",
    "        if item_i == item_j:\n",
    "            continue\n",
    "\n",
    "        original_probability_matrix[\n",
    "            item_i,\n",
    "            item_j,\n",
    "        ] = bradley_terry_probability(\n",
    "            item_i,\n",
    "            item_j,\n",
    "            original_parameters,\n",
    "        )\n",
    "\n",
    "        shifted_probability_matrix[\n",
    "            item_i,\n",
    "            item_j,\n",
    "        ] = bradley_terry_probability(\n",
    "            item_i,\n",
    "            item_j,\n",
    "            shifted_parameters,\n",
    "        )\n",
    "\n",
    "maximum_probability_difference = np.nanmax(\n",
    "    np.abs(\n",
    "        original_probability_matrix\n",
    "        - shifted_probability_matrix\n",
    "    )\n",
    ")\n",
    "\n",
    "original_probability_table = pd.DataFrame(\n",
    "    original_probability_matrix,\n",
    "    index=identifiability_items,\n",
    "    columns=identifiability_items,\n",
    ")\n",
    "\n",
    "shifted_probability_table = pd.DataFrame(\n",
    "    shifted_probability_matrix,\n",
    "    index=identifiability_items,\n",
    "    columns=identifiability_items,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Original parameter probabilities\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    original_probability_table\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Shifted parameter probabilities\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    shifted_probability_table\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Maximum probability difference:\",\n",
    "    maximum_probability_difference,\n",
    ")"
   ]
